# AVELSORN - Umgebungsvariablen (Vorlage)
# Kopieren Sie diese Datei zu .env.local und tragen Sie Ihre echten Werte ein.
# WICHTIG: .env.local darf niemals in Git committet werden!

# Supabase (Region Frankfurt / eu-central-1)
# URL Ihres Supabase-Projekts
NEXT_PUBLIC_SUPABASE_URL=https://ihr-projekt-id.supabase.co
# Öffentlicher Anon-Key (im Client nur für minimale, abgesicherte Aufgaben)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service-Role-Key (NUR serverseitig in Route Handlers verwendet, niemals NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# E-Mail-Versand (Checkdomain SMTP)
SMTP_HOST=mail.checkdomain.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kontakt@avelsorn.de
SMTP_PASS=ihr_passwort_hier
NOTIFICATION_RECIPIENT=kontakt@avelsorn.de

# Optionale Absicherung
# Falls Upstash Redis für globales Rate Limiting genutzt wird (ansonsten greift der integrierte In-Memory-Limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Öffentliche URL der Website
NEXT_PUBLIC_SITE_URL=https://avelsorn.de
